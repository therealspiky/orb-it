# Supabase project (Settings > API). The service role key bypasses RLS: keep it on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Brief generation and source analysis
ANTHROPIC_API_KEY=
# Only if Anthropic says the key "is not scoped to a workspace": the workspace ID from console.anthropic.com > Settings > Workspaces
ANTHROPIC_WORKSPACE_ID=
ANALYSIS_MODEL=claude-haiku-5-5
BRIEF_MODEL=claude-sonnet-5-5

# Transcription: openai (whisper-1, real segment timestamps, no speaker labels)
#             or deepgram (nova-3, timestamps + speaker separation)
TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# YouTube (optional). See docs/YOUTUBE.md.
# OAuth client (Web application) used to connect channels and download their captions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key restricted to the YouTube Data API v3: full video details for any public video.
YOUTUBE_API_KEY=

# Tuning
POLL_MS=3000
MAX_UPLOAD_MB=2048
CHUNK_SECONDS=600
